# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/shared/package.json ./packages/shared/

# Install dependencies
RUN npm install -g pnpm@12.15.0
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/backend ./apps/backend
COPY apps/frontend ./apps/frontend

# Build shared package
RUN cd packages/shared && pnpm build

# Build frontend (served by Fastify static in production)
RUN cd apps/frontend && pnpm build

# Generate Prisma client
RUN cd apps/backend && npx prisma generate

# Build backend
RUN cd apps/backend && pnpm build

# Create a pruned production deployment containing only the backend workspace
RUN pnpm --filter @kalenda/backend deploy --prod /prod/backend && \
    cd /prod/backend && npx prisma generate

# Production stage
FROM node:20-alpine AS production

WORKDIR /app

# Copy the pruned production dependencies and backend metadata
COPY --from=builder /prod/backend/node_modules ./node_modules
COPY --from=builder /prod/backend/package.json ./apps/backend/package.json
COPY --from=builder /prod/backend/prisma ./apps/backend/prisma
COPY --from=builder /prod/backend/prisma.config.ts ./apps/backend/prisma.config.ts

# Copy built files
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/frontend/dist ./apps/backend/frontend/dist

# Create data directories with correct ownership for non-root user
RUN mkdir -p /data/uploads/thumbs /data/exports && \
    chown -R node:node /data

WORKDIR /app/apps/backend

# Run as non-root user
USER node

# Expose port
EXPOSE 3000

# Run migrations, seed admin user, then start the application
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/seed-prod.js && node dist/server.js"]